# Copy to .env.local for local development, and set the same names in the
# Vercel project settings for deploys. No real values belong in this file.

# --- Google OAuth2, used to send form mail through Gmail ---
# From the Google Cloud console, OAuth 2.0 Client ID (Web application).
# The consent screen must be in "In production" publishing status: while it is
# in "Testing", the refresh token expires after 7 days and every form
# submission starts failing silently.
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# Gmail account that sends the mail (the OAuth client's account).
WEBMASTER_EMAIL=

# Where form submissions are delivered. May be the same as WEBMASTER_EMAIL.
RECIPIENT_EMAIL=

# --- reCAPTCHA v3 ---
# NOTE: NEXT_PUBLIC_* is inlined at BUILD time. If this is unset when Vercel
# builds, an empty string is baked into the client bundle permanently and every
# submission 403s until you rebuild. Set it before the first deploy.
# The production domain must also be registered for this key in the reCAPTCHA
# admin console.
NEXT_PUBLIC_RECAPTCHA_KEY=
RECAPTCHA_SECRET_KEY=

# --- Optional ---
# Canonical origin for metadata, sitemap and robots. Defaults to Vercel's
# VERCEL_PROJECT_PRODUCTION_URL; set this once a custom domain is attached.
# NEXT_PUBLIC_SITE_URL=https://example.com
